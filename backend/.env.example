# Copy this file to .env (same directory) and fill in real values.
# .env is git-ignored and must never be committed.
# Format: plain KEY=VALUE, do NOT quote values.
#
# JDBC URL notes:
#  - channel_binding=require is a libpq/psql-only parameter and is rejected by
#    the PostgreSQL JDBC driver. Omit it from DB_URL; Neon enforces channel
#    binding server-side regardless.
#  - sslmode=verify-full encrypts AND verifies the server certificate. Prefer it
#    over sslmode=require outside local development.

# --- Neon via the local WebSocket bridge (use on networks that block :5432) ---
# Start the bridge first, from the backend/ directory:
#     node tools/neon-ws-bridge.mjs
# Then:
DB_URL=jdbc:postgresql://127.0.0.1:5433/neondb?sslmode=disable
DB_USERNAME=<role>
DB_PASSWORD=<password>

# --- Neon direct (use when outbound TCP 5432 is permitted) ---
# DB_URL=jdbc:postgresql://<neon-host>:5432/neondb?sslmode=verify-full

# --- Local PostgreSQL (alternative) ---
# DB_URL=jdbc:postgresql://localhost:5432/apsfc_lms
# DB_USERNAME=apsfc_user
# DB_PASSWORD=change-me

# 256-bit (32+ char) secret used to sign JWT tokens
JWT_SECRET=change-me-please-a-minimum-of-32-characters
JWT_EXPIRATION_MS=28800000